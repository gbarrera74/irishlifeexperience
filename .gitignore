# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud/Finder duplicate-file artefacts ("Footer 2.tsx"). These appear when the
# project lives under a synced folder and will break the build if committed.
* [0-9].*

# WordPress source material — bulky and re-fetchable from the servers.
# See MIGRATION.md for how to pull these down again.
/export/uploads/
/export/ile_uploads/
/export/html/

# Harvested source material — bulky and re-fetchable from the server.
/export/uploads/
/export/html/

# Private key
*.pem
*.ppk

# Rescued media from the sister site (re-fetchable; see MIGRATION.md)
/export/iw_uploads/

# Built media — regenerate with the localize_* and optimize_* scripts
/public/images/

# Machine-local Claude Code settings — permissions and MCP servers for whoever
# happens to be working here, not project configuration.
settings.local.json
.claude/settings.local.json
