             "font-family": "var( --e-global-typography-text-font-family ), Sans-serif",
             "color": "#1E3A43"
            }
           },
           "hide": null,
           "html": "<p>By the end of the Irish Life Experience, each participant will have:</p>"
          },
          {
           "type": "icon-list",
           "id": "1d4de94",
           "style": {
            ".elementor-icon-list-icon i": {
             "color": "#6EC1E4"
            },
            ".elementor-icon-list-item > .elementor-icon-list-text": {
             "font-family": "var( --e-global-typography-text-font-family ), Sans-serif"
            },
            ".elementor-icon-list-item > a": {
             "font-family": "var( --e-global-typography-text-font-family ), Sans-serif"
            },
            ".elementor-icon-list-text": {
             "color": "#1E3A43"
            }
           },
           "hide": null,
           "items": [
            {
             "text": "Experienced  campus living with their peers from all over North America.",
             "link": null
            },
            {
             "text": "Developed  an understanding of the evolution of Irish social and political history from early AD to the present day, as well as how developments in Ireland have affected and influenced the rest of the world.",
             "link": null
            },
            {
             "text": "Read and reflected  on the works of several authors from both contemporary and past Irish and Anglo-Irish literature.",
             "link": null
            },
            {
             "text": "Learned  and been able to participate in the joys of Irish folk dancing.",
             "link": null
            },
            {
             "text": "Been introduced  to the basics of the Irish language.",
             "link": null
            },
            {
             "text": "Working knowledge  of Irish drama, music, and song.",
             "link": null
            },
            {
             "text": "Engaged in  and have a general understanding of Irish sports; such as Gaelic football, hurling, and rugby.",
             "link": null
            }
           ]
          }
         ],
         "width": 100
        }
       ]
      }
     ],
     "width": 100
    }
