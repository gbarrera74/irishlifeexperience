           },
           "text": "Newtown School-Waterford, Ireland",
           "tag": "h3",
           "link": null,
           "size": null
          },
          {
           "type": "text-editor",
           "id": "66ff2ed",
           "style": {
            "> .elementor-widget-container": {
             "padding": "0px 0px 0px 0px",
             "margin": "0px 0px 0px 0px"
            },
            "": {
             "font-family": "var( --e-global-typography-text-font-family ), Sans-serif",
             "color": "#1E3A43"
            }
           },
           "html": "<p><span style=\"color: #333333;\">At Newtown School, students will be assigned to rooms that sleep up to five.  Both dorms have shared bathrooms.  Students will have access to football fields, outdoor/indoor basketball courts, a lecture hall where the Irish Life Experience will show movies from their media library, as well as access to a pool that has designated swim times.  Newtown School is located within a 15-minute walk to Waterford's city center.</span></p>"
          }
         ],
         "width": 50
        }
       ],
       "structure": "20"
      }
